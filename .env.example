# Copy to .env and fill in. .env is gitignored; never commit it.

# PIN for admin mode and cancel/uncancel/reset. Defaults to 0000 if unset.
CANCEL_PIN=

# HTTP port.
# PORT=3000

# Hours after the first RSVP before the list auto-clears.
# CLEAR_AFTER_HOURS=48

# Set when running behind a reverse proxy so PIN rate limiting sees real client
# IPs (1 = one proxy hop). Leave unset when the server is reached directly.
# TRUST_PROXY=1
